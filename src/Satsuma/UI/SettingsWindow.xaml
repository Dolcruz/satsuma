<ui:FluentWindow x:Class="Satsuma.UI.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Satsuma"
                 Width="760" Height="820" MinWidth="560" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Satsuma" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Satsuma.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel Margin="36,4,36,36" MaxWidth="900">

                <!-- Hero -->
                <Grid Margin="0,8,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/Satsuma.png" Width="64" Height="64" Margin="0,0,18,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="Title" Text="Satsuma" />
                        <ui:TextBlock FontTypography="Body" Appearance="Secondary"
                                      Text="Drag a file. Tap a key. Drop it on a format. Everything stays on this PC." />
                    </StackPanel>
                </Grid>

                <!-- How it works -->
                <ui:Card Padding="20" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="HandDraw24" FontSize="26" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <ui:TextBlock Margin="0,8,0,2" FontTypography="BodyStrong" Text="1  Drag any file" />
                            <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" Text="From Explorer, the desktop, your browser — anywhere." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="26" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <ui:TextBlock Margin="0,8,0,2" FontTypography="BodyStrong" Text="2  Tap a key while dragging" />
                            <ui:TextBlock x:Name="HowKeys" Appearance="Secondary" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="26" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <ui:TextBlock Margin="0,8,0,2" FontTypography="BodyStrong" Text="3  Drop on a slice" />
                            <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" Text="The new file appears right next to the original." />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Gestures -->
                <ui:TextBlock FontTypography="BodyStrong" Text="Wheels" Margin="0,0,0,8" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSwap24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Convert wheel" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="Turn files into other formats — HEIC → JPG, MOV → MP4, PDF → PNG…" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="ConvertKey" MinWidth="140" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Wrench24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Tools wheel" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="Compress, resize, rotate, merge PDFs, mute videos, zip…" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="ToolsKey" MinWidth="140" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,24" Icon="{ui:SymbolIcon Flash24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Actions wheel" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="Share, float, copy or move, copy path, open Terminal — works on folders too." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="ActionsKey" MinWidth="140" />
                </ui:CardControl>

                <!-- Keyboard & Explorer -->
                <ui:TextBlock FontTypography="BodyStrong" Text="Without dragging" Margin="0,0,0,8" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon KeyCommand24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Keyboard shortcut  ·  Ctrl + Shift + Space" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" TextWrapping="Wrap"
                                          Text="Opens the wheel for the files selected in Explorer. Arrow keys to choose, Enter to apply, Shift / Ctrl / Alt to switch wheels." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="Shortcut" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,24" Icon="{ui:SymbolIcon Folder24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="&quot;Convert with Satsuma&quot; in the Explorer menu" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="Right-click a file → Show more options." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ContextMenuSwitch" />
                </ui:CardControl>

                <!-- Output -->
                <ui:TextBlock FontTypography="BodyStrong" Text="Output" Margin="0,0,0,8" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderOpen24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Show the result in Explorer" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="Files are saved next to the original and never overwrite anything." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="Reveal" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Image24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Image quality" />
                            <ui:TextBlock x:Name="QualityLabel" Appearance="Secondary" FontTypography="Caption" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Slider x:Name="Quality" Width="200" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,24" Icon="{ui:SymbolIcon DocumentPdf24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="PDF page images" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="Resolution used for PDF → PNG / JPG." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="PdfDpi" MinWidth="140" />
                </ui:CardControl>

                <!-- Media -->
                <ui:TextBlock FontTypography="BodyStrong" Text="Video &amp; audio" Margin="0,0,0,8" />
                <ui:CardControl Margin="0,0,0,24" Icon="{ui:SymbolIcon Video24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="FFmpeg engine" />
                            <ui:TextBlock x:Name="FfmpegStatus" Appearance="Secondary" FontTypography="Caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button x:Name="FfmpegButton" Content="Download" Appearance="Primary" />
                </ui:CardControl>

                <!-- General -->
                <ui:TextBlock FontTypography="BodyStrong" Text="General" Margin="0,0,0,8" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Start with Windows" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="Satsuma lives quietly in the system tray." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="Startup" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Info24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock x:Name="VersionText" FontTypography="Body" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="Open source · MIT License · no telemetry, no uploads" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="GitHubButton" Content="GitHub" Margin="0,0,8,0" Icon="{ui:SymbolIcon Open24}" />
                        <ui:Button x:Name="QuitButton" Content="Quit Satsuma" />
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
